# Copy to `.env.local` (Next.js) or `.env` (pnpm seed) và điền giá trị.

# MongoDB — dev chạy mongod local, prod dùng Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/moodle_quiz

# Mật khẩu đăng nhập /admin (dev)
ADMIN_PASSWORD=doi-mat-khau-nay

# Bí mật ký cookie phiên admin — tạo bằng: openssl rand -hex 32
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Google Gemini cho phần giải thích (streaming)
GEMINI_API_KEY=
