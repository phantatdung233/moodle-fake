# Copy to `.env.local` (Next.js) or `.env` (pnpm seed) và điền giá trị.

# MongoDB — dev chạy mongod local, prod dùng Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/moodle_quiz

# Mật khẩu đăng nhập /admin (dev)
ADMIN_PASSWORD=doi-mat-khau-nay

# Bí mật ký cookie phiên admin — tạo bằng: openssl rand -hex 32
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# API sinh giải thích (River AI, endpoint OpenAI-compatible). Để trống vẫn chạy
# — UI hiện "Chưa cấu hình API giải thích". Key lấy từ River AI.
RIVER_API_KEY=
# Model dùng khi sinh giải thích — bỏ trống để dùng mặc định
# deepseek-ai/DeepSeek-V4.1-Flash
EXPLAIN_MODEL=
# Base URL của endpoint chat-completions — bỏ trống để dùng https://api.river.ai/v1
EXPLAIN_BASE_URL=
